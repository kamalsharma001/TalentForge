# ==============================================================================
# TalentForge Frontend — Environment Variables
# ==============================================================================
# Copy this file to .env and configure the values for your environment.

# ------------------------------------------------------------------------------
# 1. BACKEND API BASE URL (NO TRAILING SLASH, DO NOT INCLUDE /api)
# ------------------------------------------------------------------------------
# Local dev:   Leave blank — Vite proxy handles /api → http://localhost:8000
# Production:  https://your-render-app.onrender.com
# (api.js automatically appends '/api' to VITE_API_URL)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH (REQUIRED ONLY FOR "CONTINUE WITH GOOGLE" OAUTH)
# ------------------------------------------------------------------------------
# Public Supabase URL and Anon Key (safe to expose to browser; secured by RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
