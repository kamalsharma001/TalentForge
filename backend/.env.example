# ==============================================================================
# TalentForge Backend — Environment Variables Example
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# Local development defaults are provided where applicable.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on Render/Railway. Controls debug flags and DB connection pool.
FLASK_ENV=development

# Allowed frontend origin for CORS and client redirection (no trailing slash).
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL (Supabase, Neon, AWS RDS, or local).
# Example format: postgresql://username:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/talentforge

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (BACKEND JWT)
# ------------------------------------------------------------------------------
# Secret key used for HS256 signing and verifying access/refresh JWT tokens.
# In production, generate a secure 64-char hex key: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ENGINE
# ------------------------------------------------------------------------------
# Required for AI Preparation Plans, Practice Questions, and Mock Interviews.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Primary Gemini model family used across all AI interview services.
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. SUPABASE AUTH (GOOGLE OAUTH HANDSHAKE)
# ------------------------------------------------------------------------------
# Required only if "Continue with Google" OAuth login is enabled.
# The backend uses this URL to retrieve public JWKS keys to verify Google OAuth tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 6. OPTIONAL SERVICES (NOT REQUIRED FOR CANDIDATE AI MOCK INTERVIEW DEPLOYMENT)
# ------------------------------------------------------------------------------
# Cloudinary CDN Storage:
# OPTIONAL. The candidate AI mock interview workflow uses an automatic in-memory
# text extraction and local database fallback when Cloudinary is not configured.
# Configure only if you wish to host raw PDF files or video recordings on Cloudinary CDN.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# SMTP Email Dispatch:
# OPTIONAL. Used for sending email notifications on human interview scheduling.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=your@email.com
